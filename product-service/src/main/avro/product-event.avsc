// src/main/avro/product-event.avsc
{
  "type": "record",
  "name": "ProductEvent",
  "namespace": "com.ecommerce.product.events.avro",
  "doc": "Domain event published when a product state changes. Registered in Confluent Schema Registry with BACKWARD compatibility.",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique event identifier (UUID)"
    },
    {
      "name": "eventType",
      "type": "string",
      "doc": "PRODUCT_CREATED | PRODUCT_UPDATED | PRODUCT_DELETED | STOCK_UPDATED | PRICE_CHANGED"
    },
    {
      "name": "productId",
      "type": "string",
      "doc": "UUID of the affected product"
    },
    {
      "name": "timestamp",
      "type": "long",
      "doc": "Event time as epoch milliseconds"
    },
    {
      "name": "version",
      "type": "int",
      "default": 1,
      "doc": "Event schema version for forward-compatible consumers"
    },
    {
      "name": "payload",
      "type": ["null", "string"],
      "default": null,
      "doc": "JSON-encoded event-specific data (null for delete events)"
    },
    {
      "name": "correlationId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Distributed tracing correlation ID"
    }
  ]
}